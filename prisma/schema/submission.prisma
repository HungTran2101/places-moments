model Submission {
  id              String   @id @default(cuid())
  description     String   @db.VarChar(600)
  lat             Float
  lng             Float
  weather_summary String?
  weather_code    Int?
  author_uuid     String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([author_uuid])
  @@index([lat, lng])
  @@map("submissions")
}
