model FutureMessage {
  id               String    @id @default(cuid())
  author_uuid      String
  message          String    @db.VarChar(1000)
  unlock_condition String // e.g. "after_days:30" | "random"
  created_at       DateTime  @default(now())
  unlocked_at      DateTime?

  @@index([author_uuid])
  @@map("future_messages")
}
